# Pagifye Scraper Configuration

# Chrome browser executable path (macOS default shown)
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Pagifye cookies (copy from browser)
# AccessToken cookie value
ACCESS_TOKEN=your_access_token_here

# RefreshToken cookie value
REFRESH_TOKEN=your_refresh_token_here

# PostHog analytics cookie value (optional)
POSTHOG_COOKIE=your_posthog_cookie_value_here
