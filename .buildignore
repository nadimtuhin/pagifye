# Build Ignore File
# Files and directories to exclude from WordPress plugin zip

# Development files
.git/
.github/
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation
*.md
docs/
README.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE.md

# Node.js
node_modules/
npm-debug.log
yarn-error.log
package.json
package-lock.json
yarn.lock
.npmrc
.nvmrc

# PHP Development
vendor/
composer.json
composer.lock
phpunit.xml
phpunit.xml.dist
.phpunit.result.cache

# Tests
tests/
test/
*.test.php
*.spec.php
coverage/
.phpunit.cache/

# Build artifacts
build/
dist/
*.zip

# Source files (if using build process)
src/
tailwind/
webpack.config.js
postcss.config.js
tailwind.config.js

# Environment
.env
.env.*
.env.local
.env.docker

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Git
.gitignore
.gitattributes
.gitmodules

# CI/CD
.travis.yml
.gitlab-ci.yml
.github/
circle.yml
bitbucket-pipelines.yml

# IDE
*.sublime-project
*.sublime-workspace
.project
.settings/

# Logs
*.log
logs/

# Temporary
tmp/
temp/
cache/

# Scripts (build scripts not needed in plugin)
scripts/

# WordPress specific
.htaccess
wp-config.php

# Source maps
*.map

# Scraper (not needed in plugin)
scraper/
components/
examples/

# Docker
docker/
docker-compose.yml
docker-compose.*.yml
Dockerfile
.dockerignore
