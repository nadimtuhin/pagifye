<?xml version="1.0"?>
<phpunit
	bootstrap="bootstrap.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
	>
	<testsuites>
		<testsuite name="Pagifye Elementor Widgets Test Suite">
			<directory prefix="test-" suffix=".php">./</directory>
		</testsuite>
	</testsuites>
	<filter>
		<whitelist addUncoveredFilesFromWhitelist="true">
			<directory suffix=".php">../pagifye-elementor-widgets</directory>
			<exclude>
				<directory suffix=".php">../pagifye-elementor-widgets/vendor</directory>
			</exclude>
		</whitelist>
	</filter>
</phpunit>
